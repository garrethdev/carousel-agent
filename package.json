{
  "name": "caraousel_agent",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node src/server.ts",
    "test:carousel": "ts-node tests/runSampleCarousel.ts",
    "test:all": "npm run test:carousel",
    "virlo:status": "ts-node src/cli/virlo.ts status",
    "virlo:ensure": "ts-node src/cli/virlo.ts ensure",
    "virlo:pull": "ts-node src/cli/virlo.ts pull",
    "virlo:analyze": "ts-node src/cli/virlo.ts analyze",
    "virlo:run": "ts-node src/cli/virlo.ts run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "virlo:summary": "ts-node src/cli/virlo.ts summary"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.30",
    "@types/swagger-jsdoc": "^6.0.1",
    "@types/swagger-ui-express": "^4.1.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
