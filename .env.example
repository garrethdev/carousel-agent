# Copy to .env and fill in real values. Do NOT commit .env.

# OpenRouter (LLM text generation)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx

# Google Gemini (image generation)
GEMINI_API_KEY=xxxxxxxx

# Virlo Trends & Virality API (hook corpus)
# Key format: virlo_tkn_...
VIRLO_API_KEY=virlo_tkn_xxxxxxxx

# Comma-separated Virlo content-research agent ids to analyze by default
# (used by `npm run analyze:hooks` when no ids are passed as args).
VIRLO_AGENT_IDS=
